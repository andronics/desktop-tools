#compdef devices

# Completion for `devices` (andronics/desktop-tools): the printer and the scanner (record 0004).
#
# Generated by scripts/gen-completions.py from the Typer app: don't edit it.
# Change the app and run `uv run scripts/gen-completions.py`; an installed desktop-tools
# writes the same file with `desktop-tools completions zsh --out <dir>`. Named
# _devices_cmd, after the dotfiles' completions (see _coord_cmd).

_devices_cmd() {
    local curcontext=$curcontext state state_descr line
    typeset -A opt_args
    local -a commands
    commands=(
        'printer:The default CUPS queue'
        'scan:Scan with the remembered preset'
        'scanner:The scanner'
    )

    _arguments -C \
        '(- *)'{-h,--help}'[Show help and exit]' \
        '1:command:->command' \
        '*::arg:->args'

    case $state in
        command)
            _describe -t commands 'devices command' commands
            ;;
        args)
            curcontext=${curcontext%:*:*}:devices-$words[1]:
            case $words[1] in
                printer)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                scan)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
                scanner)
                    _arguments -s -S \
                        '(- *)'{-h,--help}'[Show help and exit]'
                    ;;
            esac
            ;;
    esac
}

_devices_cmd "$@"
